{
  "name": "checkquest",
  "version": "1.0.0",
  "description": "Autonomous exploratory QA agent for safe web testing, evidence collection, and structured reporting using TypeScript, Playwright, Gemini, and Zod.",
  "main": "index.js",
  "scripts": {
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint \"agent/**/*.ts\" \"tests/**/*.ts\" \"pages/**/*.ts\" playwright.config.ts",
    "lint:md": "markdownlint-cli2 \"AGENTS.md\" \"README.md\" \"docs/**/*.md\"",
    "test:deterministic": "tsx agent/run-deterministic-checks.ts",
    "test:browser:ci": "tsx agent/run-deterministic-checks.ts agent:navigation-policy-browser-check agent:stage4a-browser-acceptance-check agent:stage4b-browser-acceptance-check agent:passive-security-browser-check agent:candidate-investigation-check agent:run-site-browser-integration-check",
    "check": "npm run typecheck && npm run lint && npm run lint:md && npm run test:deterministic",
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium",
    "report": "playwright show-report",
    "agent:check": "tsx agent/browser-check.ts",
    "agent:gemini-check": "tsx agent/gemini-sdk-check.ts",
    "agent:api-check": "tsx agent/gemini-api-check.ts",
    "agent:decide": "tsx agent/first-agent-decision.ts",
    "agent:navigation-check": "tsx agent/navigation-check.ts",
    "agent:navigation-choice": "tsx agent/navigation-choice-check.ts",
    "agent:navigation-visit": "tsx agent/navigation-visit-check.ts",
    "agent:run": "tsx agent/run-site-agent.ts",
    "agent:explore": "tsx agent/run-site-agent.ts",
    "agent:evaluation-check": "tsx agent/page-evaluation-check.ts",
    "agent:visited-links-check": "tsx agent/visited-links-check.ts",
    "agent:page-diagnostics-check": "tsx agent/page-diagnostics-check.ts",
    "agent:diagnostics-classification-check": "tsx agent/diagnostics-classification-check.ts",
    "agent:screenshot-check": "tsx agent/screenshot-check.ts",
    "agent:screenshot-trigger-check": "tsx agent/screenshot-trigger-check.ts",
    "agent:page-content-check": "tsx agent/page-content-check.ts",
    "agent:page-novelty-check": "tsx agent/page-novelty-check.ts",
    "agent:route-value-check": "tsx agent/route-value-check.ts",
    "agent:navigation-policy-check": "tsx agent/navigation-policy-check.ts",
    "agent:navigation-policy-browser-check": "tsx agent/navigation-policy-browser-check.ts",
    "agent:exploratory-qa-schema-check": "tsx agent/exploratory-qa-schema-check.ts",
    "agent:exploratory-qa-prompt-check": "tsx agent/exploratory-qa-prompt-check.ts",
    "agent:exploratory-qa-analysis-check": "tsx agent/exploratory-qa-analysis-check.ts",
    "agent:action-schema-check": "tsx agent/action-schema-check.ts",
    "agent:action-executor-check": "tsx agent/action-executor-check.ts",
    "agent:stage4a-disclosure-check": "tsx agent/stage4a-disclosure-check.ts",
    "agent:stage4a-browser-acceptance-check": "tsx agent/stage4a-browser-acceptance-check.ts",
    "agent:stage4b-tab-check": "tsx agent/stage4b-tab-check.ts",
    "agent:stage4b-browser-acceptance-check": "tsx agent/stage4b-browser-acceptance-check.ts",
    "agent:planner-schema-check": "tsx agent/planner-decision-schema-check.ts",
    "agent:planner-prompt-check": "tsx agent/planner-prompt-check.ts",
    "agent:planner-decision-check": "tsx agent/planner-decision-check.ts",
    "agent:planner-execution-check": "tsx agent/planner-execution-check.ts",
    "agent:candidate-investigation-check": "tsx agent/candidate-driven-investigation-check.ts",
    "agent:exploratory-loop-check": "tsx agent/exploratory-loop-check.ts",
    "agent:site-wide-findings-check": "tsx agent/site-wide-findings-check.ts",
    "agent:site-wide-report-check": "tsx agent/site-wide-report-check.ts",
    "agent:run-site-api-check": "tsx agent/run-site-api-check.ts",
    "agent:error-handling-check": "tsx agent/error-handling-check.ts",
    "agent:gemini-hardening-check": "tsx agent/gemini-hardening-check.ts",
    "agent:gemini-credential-boundary-check": "tsx agent/gemini-credential-boundary-check.ts",
    "agent:run-event-check": "tsx agent/run-event-check.ts",
    "agent:run-site-browser-integration-check": "tsx agent/run-site-browser-integration-check.ts",
    "agent:known-findings-check": "tsx agent/known-findings-check.ts",
    "agent:unified-findings-check": "tsx agent/unified-findings-check.ts",
    "agent:finding-reconciliation-check": "tsx agent/finding-reconciliation-check.ts",
    "agent:unified-lifecycle-check": "tsx agent/unified-finding-lifecycle-check.ts",
    "agent:run-finding-lifecycle-check": "tsx agent/run-finding-lifecycle-check.ts",
    "agent:run-finding-lifecycle-integrity-check": "tsx agent/run-finding-lifecycle-integrity-check.ts",
    "agent:finding-investigation-outcome-check": "tsx agent/finding-investigation-outcome-check.ts",
    "agent:run-options-check": "tsx agent/agent-run-options-check.ts",
    "agent:site-config-check": "tsx agent/site-config-check.ts",
    "agent:cli-configuration-error-check": "tsx agent/cli-configuration-error-check.ts",
    "agent:passive-security-check": "tsx agent/passive-security-check.ts",
    "agent:passive-security-browser-check": "tsx agent/passive-security-browser-acceptance-check.ts",
    "agent:passive-security-report-check": "tsx agent/passive-security-report-check.ts"
  },
  "keywords": [
    "qa",
    "automation",
    "playwright",
    "typescript",
    "testing",
    "ai-agent",
    "exploratory-testing",
    "browser-automation"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.7.0",
    "markdownlint-cli2": "^0.23.1",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "@google/genai": false,
    "protobufjs": false
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "5.2.2"
    }
  },
  "dependencies": {
    "@google/genai": "^2.12.0",
    "zod": "^4.4.3"
  }
}
